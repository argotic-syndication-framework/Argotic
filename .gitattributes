# Line endings are pinned here rather than left to each contributor's core.autocrlf.
# An explicit eol attribute overrides core.autocrlf, so every working tree matches the
# end_of_line settings in Solutions/.editorconfig regardless of platform or local git
# config. Without this the two disagree and `dotnet format --verify-no-changes` can
# never pass as a CI gate.

# Auto-detect text files, normalize to LF in the repository, and check out as LF.
* text=auto eol=lf

# Source and config files are always text, never content-sniffed. These inherit the
# eol=lf set above.
*.cs      text
*.csx     text
*.csproj  text
*.props   text
*.targets text
*.xaml    text
*.config  text
*.xml     text
*.json    text
*.md      text
*.txt     text
*.yml     text
*.yaml    text
*.sh      text eol=lf

# Windows tooling that expects CRLF. Mirrored by the [*.{sln,slnx,ps1,cmd,bat}] section
# in Solutions/.editorconfig so both files state the same policy.
*.sln  text eol=crlf
*.slnx text eol=crlf
*.ps1  text eol=crlf
*.cmd  text eol=crlf
*.bat  text eol=crlf

# Denote all files that are truly binary and should not be modified.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.dll binary
*.exe binary
*.pdb binary
*.zip binary
*.gz binary
*.tar binary
*.7z binary
*.nupkg binary
*.snk binary
*.pfx binary

# Archived third-party schemas: never normalise line endings.
#
# These are validated against as byte-for-byte reproductions of what the publisher served, and
# Schemas/NOTICE.md says so - a checksum against the canonical URL is supposed to still match. Two of
# them arrive with CRLF, so without this git would rewrite them to LF on commit and quietly make that
# claim false for everyone who clones.
Solutions/Argotic.Extensions.Tests/Schemas/*.xsd -text
