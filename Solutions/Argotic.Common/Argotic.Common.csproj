<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Product>Argotic Syndication Framework</Product>
    <PackageDescription>Core interfaces and utilities for the Argotic Syndication Framework, including SyndicationEncodingUtility, SyndicationDateTimeUtility, and SyndicationDiscoveryUtility.</PackageDescription>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The benchmark harness measures individual stages of the load pipeline. GetStreamBytes is one
      of those stages and is internal rather than public, so the harness needs this grant. Scoped
      to the benchmark project alone - not the test project, which exercises public API only.
    -->
    <InternalsVisibleTo Include="Argotic.Benchmarks" />
    <!-- XPathNavigatorExtensions is shared with the parse path in both assemblies. It stays internal
         because it extends a BCL type: public would add members to every XPathNavigator in every
         consuming codebase. -->
    <InternalsVisibleTo Include="Argotic.Core" />
    <InternalsVisibleTo Include="Argotic.Extensions" />
  </ItemGroup>

</Project>
