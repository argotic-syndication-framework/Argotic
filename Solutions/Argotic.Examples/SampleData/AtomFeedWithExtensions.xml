  <entry>
    <title>Third Entry - Threading Extension Demo</title>
    <link href="https://example.com/entry3" rel="alternate"/>
    <link href="https://example.com/entry3/replies.atom" rel="replies" type="application/atom+xml" thr:count="15" thr:updated="2024-01-01T14:00:00Z"/>
    <id>urn:uuid:1225c695-cfb8-4ebb-aaaa-80da344efa6c</id>
    <published>2024-01-01T11:00:00Z</published>
    <updated>2024-01-01T12:00:00Z</updated>
    <summary>This entry demonstrates the Threading extension for comments.</summary>

    <!-- Threading extension -->
    <thr:total>15</thr:total>

    <content type="xhtml">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p>This entry demonstrates the <strong>Atom Threading Extension</strong> (RFC 4685).</p>
        <p>The threading extension provides:</p>
        <ul>
          <li>thr:in-reply-to for reply relationships</li>
          <li>thr:total for comment counts</li>
          <li>thr:count and thr:updated on reply links</li>
        </ul>
      </div>
    </content>

    <app:control>
      <app:draft>no</app:draft>
    </app:control>

    <category term="threading"/>
    <category term="comments"/>
  </entry>

