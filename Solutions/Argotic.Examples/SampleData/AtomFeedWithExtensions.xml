  <entry>
    <title type="text">Rx.NET v7.0 Released - it could save you 95MB!</title>
    <link href="https://endjin.com/what-we-think/talks/rxdotnet-v7-0-released" rel="alternate" type="text/html"/>
    <link href="https://endjin.com/what-we-think/talks/rxdotnet-v7-0-released.atom" rel="self" type="application/atom+xml"/>
    <link href="https://endjin.com/what-we-think/talks/rxdotnet-v7-0-released/edit" rel="edit" type="application/atom+xml"/>
    <link href="https://endjin.com/what-we-think/talks/rxdotnet-v7-0-released/media" rel="edit-media" type="image/jpeg"/>
    <id>urn:uuid:1225c695-cfb8-4ebb-aaaa-80da344efa6a</id>
    <georss:point>51.5074 -0.1278</georss:point>
    <georss:elev>11.0</georss:elev>
    <georss:featurename>London, United Kingdom</georss:featurename>
    <published>2026-07-29T09:00:00Z</published>
    <updated>2026-07-29T10:00:00Z</updated>
    <summary type="text">Moving UI framework support out of System.Reactive can cut 95MB from a self-contained deployment.</summary>

    <!-- Atom Publishing Protocol -->
    <app:control>
      <app:draft>no</app:draft>
    </app:control>
    <app:edited>2026-07-29T10:30:00Z</app:edited>

    <content type="html">&lt;p&gt;Ian Griffiths announces &lt;strong&gt;Rx.NET 7.0&lt;/strong&gt; and its three breaking changes: dropping .NET 6 and 7, a nullability fix on OfType, and the UI package split.&lt;/p&gt;&lt;p&gt;The split is the one that matters: a self-contained deployment that grew from 102MB to 197MB under Rx 6.1 no longer implicitly pulls in WPF and WinForms.&lt;/p&gt;</content>

    <!-- Dublin Core -->
    <dc:creator>Ian Griffiths</dc:creator>
    <dc:subject>Reactive Extensions</dc:subject>
    <dc:date>2026-07-29T09:00:00Z</dc:date>

    <!-- Dublin Core Metadata Terms -->
    <dcterms:abstract>Rx.NET 7.0 and the 95MB deployment saving behind its UI package split.</dcterms:abstract>

