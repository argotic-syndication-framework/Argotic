<?xml version="1.0" encoding="utf-8"?>
<rsd version="1.0" xmlns="http://archipelago.phrasewise.com/rsd">
  <service>
    <engineName>Sample Blog Engine</engineName>
    <engineLink>http://example.com/engine</engineLink>
    <homePageLink>http://example.com/blog</homePageLink>
    <apis>
      <api name="MetaWeblog" preferred="true" apiLink="http://example.com/xmlrpc" blogID="1">
        <docs>http://www.xmlrpc.com/metaWeblogApi</docs>
        <settings>
          <setting name="supportsNewPost">true</setting>
          <setting name="supportsGetCategories">true</setting>
          <setting name="supportsMediaObjects">true</setting>
        </settings>
      </api>
      <api name="Blogger" preferred="false" apiLink="http://example.com/blogger" blogID="1">
        <docs>http://www.blogger.com/developers/api/1_docs/</docs>
        <settings>
          <setting name="supportsNewPost">true</setting>
          <setting name="supportsEditPost">true</setting>
        </settings>
      </api>
      <api name="Atom" preferred="false" apiLink="http://example.com/atom" blogID="1">
        <docs>https://www.ietf.org/rfc/rfc4287.txt</docs>
        <settings>
          <setting name="supportsAtomPub">true</setting>
          <setting name="version">1.0</setting>
        </settings>
      </api>
      <api name="WordPress" preferred="false" apiLink="http://example.com/xmlrpc.php" blogID="1">
        <docs>https://developer.wordpress.org/plugins/metadata/managing-post-metadata/</docs>
        <settings>
          <setting name="supportsPages">true</setting>
          <setting name="supportsCustomFields">true</setting>
          <setting name="supportsTags">true</setting>
        </settings>
      </api>
      <api name="MovableType" preferred="false" apiLink="http://example.com/mt-xmlrpc.cgi" blogID="1">
        <docs>http://www.movabletype.org/documentation/developer/api/</docs>
        <settings>
          <setting name="supportsTrackbacks">true</setting>
        </settings>
      </api>
    </apis>
  </service>
</rsd>
